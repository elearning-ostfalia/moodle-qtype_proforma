{{!
    @template qtype_proforma/taskeditor_fileref_viewer

    Read-only viewer row for the content of a referenced file in the ProFormA task editor.
    The row is inserted below the file reference row when the user clicks 'View'
    (only the row is used, the table is needed for valid HTML).

    Classes required for JS:
    * fileref_viewer

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * colspan - number of table columns the viewer spans
    * text - file content (escaped by Mustache)

    Example context (json):
    {
        "colspan": 7,
        "text": "public class Foo {\n}"
    }
}}
<table>
<tbody>
<tr>
    <td></td>
    <td colspan="{{colspan}}"><textarea disabled cols="80" rows="10" class="fileref_viewer">{{text}}</textarea></td>
</tr>
</tbody>
</table>
