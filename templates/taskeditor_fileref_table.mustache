{{!
    @template qtype_proforma/taskeditor_fileref_table

    The purpose of this template is to render a table with one file reference row in ProFormA task editor.
    The row itself is defined in taskeditor_fileref_row which is also used in JS for further rows.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * filenamelabel

    Example context (json):
    {
        "filenamelabel": "Junit and other file(s)"
    }
}}

<table class="dynamic_table xml_fileref_table">
<tbody>
{{> qtype_proforma/taskeditor_fileref_row }}
</tbody>
</table>
