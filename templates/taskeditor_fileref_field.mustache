{{!
    @template qtype_proforma/taskeditor_fileref_field

    File reference list as a Moodle-like form element (label column + field column).
    The table (taskeditor_fileref_table) is placed in the field column. Its first column
    contains a (hidden) copy of the label that is still needed by JS.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * info - optional help icon context
    * filemandatory - true if at least one file is required

    Example context (json):
    {
        "filemandatory": true
    }
}}
<div class="row mb-2 fitem proforma-fitem proforma-fileref-fitem">
    <div class="col-md-3 col-form-label d-flex pb-0 pe-md-0">
        <label class="d-inline word-break mb-0">{{#str}} taskeditorfiles, qtype_proforma {{/str}}</label>
        <div class="form-label-addon d-flex align-items-center align-self-start">
            {{#filemandatory}}
            <div class="text-danger" title="{{#str}} required {{/str}}" aria-hidden="true">{{#pix}} req, core {{/pix}}</div>
            {{/filemandatory}}
            {{#info}}
            {{>core/help_icon}}
            {{/info}}
        </div>
    </div>
    <div class="col-md-9 felement">
        {{> qtype_proforma/taskeditor_fileref_table }}
    </div>
</div>
