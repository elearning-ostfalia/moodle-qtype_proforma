{{!
    @template qtype_proforma/taskeditor_file

    The purpose of this template is to render a Junit test in ProFormA task editor

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * none

    Example context (json):
    {
    }
}}


{{< qtype_proforma/taskeditor_test }}
{{$testspecific}}
<div class="row mb-2 fitem proforma-fitem">
    <div class="col-md-3 col-form-label d-flex pb-0 pe-md-0">
        <label class="d-inline word-break mb-0" for="test_{{ testid }}_entrypoint">{{#str}} executable, qtype_proforma {{/str}}</label>
        <div class="form-label-addon d-flex align-items-center align-self-start">
            <div class="text-danger" title="{{#str}} required {{/str}}" aria-hidden="true">{{#pix}} req, core {{/pix}}</div>
            {{#entrypointinfo}}
            {{>core/help_icon}}
            {{/entrypointinfo}}
        </div>
    </div>
    <div class="col-md-9 d-flex flex-wrap align-items-start felement">
        <input id='test_{{ testid }}_entrypoint' class='xml_entry_point form-control' value='{{ entrypoint }}' size="80">
    </div>
</div>
{{/testspecific}}
{{/ qtype_proforma/taskeditor_test }}

