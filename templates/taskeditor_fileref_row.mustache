{{!
    @template qtype_proforma/taskeditor_fileref_row

    One file reference row in the ProFormA task editor.
    Used as partial by taskeditor_fileref_table and rendered directly in JS
    when the user adds a further row.

    Classes required for JS:
    * fileref_filename, xml_fileref_filename, fileref_fileref, taskeditor-collapse, remove_item, add_fileref

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * info - optional help icon context
    * filemandatory - true if at least one file is required

    Example context (json):
    {
        "filemandatory": true
    }
}}
<tr>
    <td>
        <label>{{#str}} taskeditorfiles, qtype_proforma {{/str}}
{{#info}}
    {{>core/help_icon}}
{{/info}}
        {{ #filemandatory }}
            <i class="icon fa fa-exclamation-circle text-danger fa-fw" title="{{# str }} required {{/ str }}" ></i>
            <!-- <span class="red">*</span> -->
        {{ /filemandatory }}
        </label>
    </td>
    <td>
        <select class="mediuminput fileref_filename xml_fileref_filename form-select form-select-sm">
            <option value=" " label=" "> </option>
            {{! cleanstr because the strings contain '<' and '>' (e.g. '<New file>'). }}
            <option>{{#cleanstr}} openfile, qtype_proforma {{/cleanstr}}</option>
            <option>{{#cleanstr}} newfile, qtype_proforma {{/cleanstr}}</option>
        </select>
    </td>
    <td>
        <label class="fileref_fileref_label" style="display: none;">Fileref:
            <input class="tinyinput fileref_fileref" readonly="" style="display: none;">
        </label>
    </td>
    <td>
        <button class="taskeditor-collapse btn btn-sm btn-outline-secondary" disabled="">{{#str}} taskeditorview, qtype_proforma {{/str}}</button>
    </td>
    <td>
        <button class="remove_item btn btn-sm btn-outline-secondary" style="display: none;" title="{{#str}} delete {{/str}}">&times;</button>
    </td>
    <td>
         <button class="add_fileref btn btn-sm btn-outline-secondary" title="{{#str}} add {{/str}}">+</button>
         <br>
    </td>
    <td>
    </td>
</tr>
