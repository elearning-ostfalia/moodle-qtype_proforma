{{!
    @template qtype_proforma/taskeditor_fileref_row

    One file reference row in the ProFormA task editor.
    Used as partial by taskeditor_fileref_table and rendered directly in JS
    when the user adds a further row.

    Classes required for JS:
    * proforma-required (marks the label of a mandatory file list)
    * fileref_filename, xml_fileref_filename, fileref_fileref, taskeditor-collapse, remove_item, add_fileref

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * info - optional help icon context
    * filemandatory - true if at least one file is required

    Example context (json):
    {
        "filemandatory": true
    }
}}
<tr>
    <td>
        {{! First column is hidden by CSS (the visible label is in taskeditor_fileref_field).
            The label is still needed by JS: it is copied into further rows and task.js
            checks for .proforma-required to detect mandatory file lists. }}
        <label class="proforma-label">
            <span class="proforma-label-text">{{#str}} taskeditorfiles, qtype_proforma {{/str}}</span>
            <span class="form-label-addon">
                {{#filemandatory}}
                {{! Class proforma-required is used in JS (task.js) to detect mandatory files. }}
                <span class="text-danger proforma-required" title="{{#str}} required {{/str}}">{{#pix}} req, core {{/pix}}</span>
                {{/filemandatory}}
                {{#info}}
                {{>core/help_icon}}
                {{/info}}
            </span>
        </label>
    </td>
    <td>
        <select class="mediuminput fileref_filename xml_fileref_filename form-select">
            <option value=" " label=" "> </option>
            {{! cleanstr because the strings contain '<' and '>' (e.g. '<New file>'). }}
            <option>{{#cleanstr}} openfile, qtype_proforma {{/cleanstr}}</option>
            <option>{{#cleanstr}} newfile, qtype_proforma {{/cleanstr}}</option>
        </select>
    </td>
    <td>
        <label class="fileref_fileref_label" style="display: none;">Fileref:
            <input class="tinyinput fileref_fileref" readonly="" style="display: none;">
        </label>
    </td>
    <td>
        <button class="taskeditor-collapse btn btn-outline-secondary" disabled="">{{#str}} taskeditorview, qtype_proforma {{/str}}</button>
    </td>
    <td>
        <button class="remove_item btn btn-outline-secondary proforma-delete" style="display: none;" title="{{#str}} delete {{/str}}" aria-label="{{#str}} delete {{/str}}">{{# pix }} t/delete, core, {{/ pix }}</button>
    </td>
    <td>
         <button class="add_fileref btn btn-outline-secondary" title="{{#str}} add {{/str}}">+</button>
    </td>
    <td>
    </td>
</tr>
