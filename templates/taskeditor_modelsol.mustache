{{!
    @template qtype_proforma/taskeditor_file

    The purpose of this template is to render a file in ProFormA task editor

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * none

    Example context (json):
    {
        "msid": "1",
        "description": "Model solution"
    }
}}


<div id="modelsolution_{{ msid }}" class="xml_model-solution">
    <span class='modelsol-header'><span class='box-typ'>{{#str}} modelsolution, qtype_proforma {{/str}} {{ msid }}</span>
    {{! Must stay the first button in the box (JS: find('button').first() deletes it). }}
    <span class='rightButton'><button class="btn btn-sm btn-outline-secondary proforma-delete" title="{{#str}} delete {{/str}}" aria-label="{{#str}} delete {{/str}}">{{# pix }} t/delete, core, {{/ pix }}</button></span>
    </span>

    <div style="display: none;">
        <label for="xml_model-solution_id_{{ msid }}" style="display: none;">ID: </label>
        <input id="xml_model-solution_id_{{ msid }}" class="tinyinput xml_model-solution_id" value="{{ msid }}" readonly="" style="display: none;">
        <label class="leftlabel" style='display: none'>Internal Description:</label>
        <textarea rows="2" cols='80' class="xml_internal_description" style='display: none'></textarea>
    </div>
    <div class="row mb-2 fitem proforma-fitem">
        <div class="col-md-3 col-form-label d-flex pb-0 pe-md-0">
            <label class="d-inline word-break mb-0" for="modelsolution_{{ msid }}_description">{{#str}} testdescription, qtype_proforma {{/str}}</label>
            <div class="form-label-addon d-flex align-items-center align-self-start">
            </div>
        </div>
        <div class="col-md-9 d-flex flex-wrap align-items-start felement">
            <textarea id="modelsolution_{{ msid }}_description" rows="2" cols='80' class="xml_description form-control">{{ description }}</textarea>
        </div>
    </div>

    {{> qtype_proforma/taskeditor_fileref_field }}

    <span class="drop_zone_text drop_zone">{{#str}} taskeditordropzone, qtype_proforma {{/str}}</span>
</div>